# ===== REWEAR — ENVIRONMENT TEMPLATE =====
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# 1. DATABASE — PostgreSQL (Neon)
# ---------------------------------------------------------------------------
# Neon dashboard → Project → Connection Details → copy BOTH strings.
#
# DATABASE_URL  = "Pooled connection"   (host contains `-pooler`) — used at runtime.
# DIRECT_URL    = "Direct connection"   (host has NO `-pooler`)  — used by Prisma
#                 migrations, which cannot run through a transaction pooler.
# Append `?sslmode=require` to both.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST].[REGION].aws.neon.tech/[DB]?sslmode=require"

# ---------------------------------------------------------------------------
# 2. AUTH.JS / NEXTAUTH
# ---------------------------------------------------------------------------
AUTH_URL="http://localhost:3000"
# NOTE: In production (Vercel) set this to your public domain, e.g.
#   AUTH_URL="https://rewear-rust.vercel.app"
# Leaving it as localhost is tolerated (redirect origins are derived from
# x-forwarded-* headers), but a correct value is recommended.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32+-character-secret"

# ---------------------------------------------------------------------------
# 3. FIREBASE — Cloud Storage (image uploads: donation photos, NGO logo)
# ---------------------------------------------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Open the downloaded JSON and copy the three values out of it:
#   project_id → FIREBASE_PROJECT_ID
#   client_email → FIREBASE_CLIENT_EMAIL
#   private_key → FIREBASE_PRIVATE_KEY
#
# IMPORTANT: paste the private key as ONE line. Keep the literal \n escapes
# (the app converts them back to real newlines) and keep it wrapped in quotes.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Firebase console → Build → Storage → the bucket name shown at the top,
# e.g. "your-firebase-project-id.firebasestorage.app" (NOT a gs:// URL).
FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
#
# Leave this whole block blank to fall back to local filesystem storage
# (fine for `npm run dev`, NOT durable on Vercel).

# ---------------------------------------------------------------------------
# 4. EMAIL — donation approval notifications (server-only)
# ---------------------------------------------------------------------------
# When a donation is submitted, the manager receives an email with single-use
# Approve / Reject links (no login needed). Configure ANY SMTP relay here.
#
# IMPORTANT:
#   • Use a DEDICATED sending account — NEVER the NGO's public contact email.
#   • Leave these blank to run in "log" mode: emails are printed to the server
#     console instead of being sent (handy for local testing, no mail account).
#
# Gmail (easiest for testing): enable 2-Step Verification, create an
# "App Password" for a dedicated account, then:
#     SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  SMTP_SECURE="true"
# Resend:   SMTP_HOST="smtp.resend.com"  SMTP_PORT="465"  SMTP_USER="resend"
#           SMTP_PASSWORD="<RESEND_API_KEY>"
# SendGrid: SMTP_HOST="smtp.sendgrid.net" SMTP_PORT="587" SMTP_USER="apikey"
#           SMTP_PASSWORD="<SENDGRID_API_KEY>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# The "From" address shown on outgoing mail.
EMAIL_FROM="REWEAR Donations <your-dedicated-sender@example.com>"

# Where approval requests are delivered (comma-separated for multiple managers).
MANAGER_EMAIL="tanishqgames203@gmail.com"

# Approval-link lifetime, in hours (default: 168 = 7 days).
APPROVAL_TOKEN_TTL_HOURS="168"

# Display name used inside donor emails.
NGO_DISPLAY_NAME="Mangaldham Bahuuddeshiy Samajik Sanstha"

# ---------------------------------------------------------------------------
# 5. SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# CRITICAL: used to build the Approve/Reject and "Track your donation" links in
# emails. In production set it to your public domain, e.g.
#   NEXT_PUBLIC_SITE_URL="https://rewear-rust.vercel.app"
# (A localhost value is ignored in production — links then fall back to the
# incoming request host — but set it correctly to be safe.)

# ---------------------------------------------------------------------------
# 6. DEMO SEEDING — development / test ONLY
# ---------------------------------------------------------------------------
# `npm run seed` creates demo users. It is opt-in and can NEVER run against a
# production database: the script aborts when NODE_ENV=production, and also
# refuses unless SEED_DEMO_USERS=true. Never set these in Vercel/production.
#
#   SEED_DEMO_USERS="true"        # required to allow demo seeding
#   SEED_DEMO_PASSWORD=""         # optional; if blank a strong random password
#                                # is generated and printed once. Never commit.
SEED_DEMO_USERS="false"
SEED_DEMO_PASSWORD=""
