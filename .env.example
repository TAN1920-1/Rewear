# ===== REWEAR — ENVIRONMENT TEMPLATE =====
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# 1. DATABASE — Supabase PostgreSQL
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string → URI
#
# DATABASE_URL  = "Transaction pooler" (port 6543) — used by the app at runtime.
# DIRECT_URL    = "Session / direct"    (port 5432) — used by Prisma migrations.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# 2. AUTH.JS / NEXTAUTH
# ---------------------------------------------------------------------------
AUTH_URL="http://localhost:3000"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32+-character-secret"

# ---------------------------------------------------------------------------
# 3. SUPABASE — Storage (image uploads: donation photos, NGO logo)
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-public-key"
# Server-only. NEVER expose to the browser. Bypasses RLS — keep secret.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
# Storage bucket to create (make it PUBLIC for read access).
STORAGE_BUCKET="rewear"

# ---------------------------------------------------------------------------
# 4. SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
